# App
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://teamflow:password@localhost:5432/teamflow"

# JWT RS256 — base64-encoded PEM strings
# Generate: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# Then: cat private.key | base64 -w 0
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_PUBLIC_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
